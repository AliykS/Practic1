<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="using:Practic1"
        mc:Ignorable="d"
        x:Class="Practic1.MainWindow"
        Width="600"
        Height="500"
        Title="Музеи">

    <StackPanel Margin="20" Spacing="10">

        <TextBlock Text="Музеи"
                   FontSize="24"
                   HorizontalAlignment="Center"/>

        <TextBlock Text="Название музея:"/>

        <TextBox x:Name="MuseumNameTextBox"
                 Watermark="Введите название музея"/>

        <TextBlock Text="Город:"/>

        <TextBox x:Name="CityTextBox"
                 Watermark="Введите город"/>

        <Button Content="Добавить"
                Click="AddButton_Click"
                HorizontalAlignment="Center"
                Padding="20,10"/>

        <TextBlock x:Name="ErrorTextBlock"
                   Text=""
                   TextWrapping="Wrap"/>

        <TextBlock Text="Список музеев:"
                   Margin="0,10,0,0"/>

        <ListBox x:Name="MuseumsListBox"
                 Height="250">

            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="local:Museum">
                    <TextBlock>
                        <Run Text="{Binding Name}"/>
                        <Run Text=" — "/>
                        <Run Text="{Binding City}"/>
                    </TextBlock>
                </DataTemplate>
            </ListBox.ItemTemplate>

        </ListBox>

    </StackPanel>

</Window>